SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
APP_ENV=development
# Authenticate directly as the dedicated LOGIN role. Percent-encode the password.
DATABASE_URL=postgresql://orion_backend:replace_me@host:5432/postgres

# Calendar integrations are separate OAuth clients and consent flows.
GOOGLE_INTEGRATION_CLIENT_ID=
GOOGLE_INTEGRATION_CLIENT_SECRET=
GOOGLE_INTEGRATION_REDIRECT_URL=http://localhost:8080/integrations/oauth/callback
MICROSOFT_INTEGRATION_CLIENT_ID=
MICROSOFT_INTEGRATION_CLIENT_SECRET=
MICROSOFT_INTEGRATION_REDIRECT_URL=http://localhost:8080/integrations/oauth/callback
FRONTEND_INTEGRATION_CALLBACK_URL=http://localhost:3000/integrations/callback

# Stripe is backend-only and remains off unless every required value is set.
STRIPE_BILLING_ENABLED=false
# Restricted Stripe key only (rk_test_... locally, rk_live_... in production).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=
STRIPE_PROFESSIONAL_ANNUAL_PRICE_ID=
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/complete?result=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing/complete?result=cancelled
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/billing/complete?result=portal
